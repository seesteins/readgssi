# Use the Nix environment defined in shell.nix
use nix

# Check if the correct Python is active from Nix
echo "--- Checking Python version provided by Nix ---"
command -v python
python --version || echo "Warning: Python command failed!"

# Define the virtual environment directory name
VENV_DIR=".venv"

# Get Python interpreter path reliably from Nix env (uses shellHook variable)
if [ -z "$UV_PYTHON_EXECUTABLE" ]; then
  echo "Error: UV_PYTHON_EXECUTABLE not set by Nix shell. Attempting fallback."
  PYTHON_EXECUTABLE="$(command -v python)"
else
  PYTHON_EXECUTABLE="$UV_PYTHON_EXECUTABLE"
fi
echo "--- Using Python: $PYTHON_EXECUTABLE ---"

# Create the virtual environment if it doesn't exist or if the Python version changed
# We check pyvenv.cfg which contains the Python path used to create the venv
CREATE_VENV=false
if [ ! -d "$VENV_DIR" ]; then
  echo "--- $VENV_DIR does not exist. ---"
  CREATE_VENV=true
elif ! grep -q "$PYTHON_EXECUTABLE" "$VENV_DIR/pyvenv.cfg"; then
  echo "--- Python interpreter changed. Recreating $VENV_DIR ---"
  # Optional: rm -rf "$VENV_DIR" # Uncomment to force deletion before recreation
  CREATE_VENV=true
fi

if $CREATE_VENV; then
  echo "--- Creating uv virtual environment in $VENV_DIR ---"
  # Use uv from the Nix environment (should be on PATH)
  uv venv "$VENV_DIR" --python "$PYTHON_EXECUTABLE" || { echo "ERROR: uv venv failed!"; exit 1; }
  echo "--- uv virtual environment created/updated ---"
fi

# Activate the virtual environment
source "$VENV_DIR/bin/activate"

echo "--- Direnv: Nix environment loaded, uv venv activated ---"
echo "--- Active Python: $(which python) ($(python --version)) ---"
echo "--- uv: $(command -v uv) ($($UV_BIN --version)) ---"